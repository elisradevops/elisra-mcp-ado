# Required
ADO_ORG_URL=https://tfs.example.local/tfs/DefaultCollection

# API version — ladder 7.0 → 5.1 → none on on-prem TFS that rejects newer versions
ADO_API_VERSION=7.0

# Concurrency
ADO_BATCH_SIZE=200
ADO_REQUEST_TIMEOUT_MS=30000

# Auth mode: per_request_pat (default, primary) | server_pat (dev/service-account)
ADO_AUTH_MODE=per_request_pat

# Only set when ADO_AUTH_MODE=server_pat — never set in per_request_pat mode
# ADO_PAT=

# Safety
ADO_READ_ONLY=true
ADO_ENABLE_DEBUG_OUTPUT=false
ADO_ALLOW_UNKNOWN_FIELDS=false
ADO_FULL_RESPONSE_MAX_ITEMS=50
ADO_MAX_REVIEW_ITEMS=500

# TLS — point at corp CA bundle for on-prem TFS with self-signed/corporate certs
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/elisra-ca.pem

# Logging
LOG_LEVEL=info

# mcpo bridge — API key and host port (sidecar container only)
MCPO_API_KEY=
MCPO_PORT=9090

# Removed by design — project access is determined by the PAT, not server config:
# ADO_DEFAULT_PROJECT
# ADO_ALLOWED_PROJECTS
# ADO_PROJECT
