# Required
ADO_ORG_URL=https://tfs.example.local/tfs/DefaultCollection

# API version — ladder 7.0 → 5.1 → none on on-prem TFS that rejects newer versions
ADO_API_VERSION=7.0

# Concurrency
ADO_BATCH_SIZE=200
ADO_REQUEST_TIMEOUT_MS=30000

# ── Auth mode ─────────────────────────────────────────────────────────────────
# server_pat          → shared service account PAT (production read-only access)
# trusted_user_header → per-user encrypted PAT from MongoDB (requires P1 vars below)
# per_request_pat     → dev only, requires ADO_ALLOW_PAT_IN_TOOL_ARGS=true
ADO_AUTH_MODE=server_pat

# Only set when ADO_AUTH_MODE=server_pat
# ADO_PAT=

# SECURITY: per_request_pat mode requires this flag AND is NOT production-safe.
# PATs travel through tool-call JSON, LLM context windows, proxy logs, and
# conversation history. Only enable for local development and testing.
# ADO_ALLOW_PAT_IN_TOOL_ARGS=true

# Safety
ADO_READ_ONLY=true
ADO_ENABLE_DEBUG_OUTPUT=false
ADO_ALLOW_UNKNOWN_FIELDS=false

# TLS — point at corp CA bundle for on-prem TFS with self-signed/corporate certs
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/elisra-ca.pem

# Logging
LOG_LEVEL=info

# mcpo bridge — API key and host port (sidecar container only, legacy profile)
# SECURITY: Must be a securely generated token of at least 16 characters.
# MCPO_API_KEY=<generate with: openssl rand -base64 32>
MCPO_PORT=9090

# ── P1: MongoDB credential store (required for trusted_user_header mode) ──────
# Connection URI — supply via Kubernetes Secret, never as plain env in YAML.
# Pattern: mongodb://user:pass@host:27017/db?authSource=admin
# Matches MONGODB_URI convention from dg-api-gate.
# MONGODB_URI=mongodb://<REDACTED_USER>:<REDACTED_PASS>@mongodb:27017/ado_mcp?authSource=admin
MONGO_DB_NAME=ado_mcp
ADO_CREDENTIALS_COLLECTION=ado_user_credentials

# ── P1: PAT encryption (required for trusted_user_header mode) ────────────────
# 32-byte AES-256-GCM master key, base64-encoded.
# Generate: openssl rand -base64 32
# Supply via Kubernetes Secret — NEVER as a plain env var in production YAML.
# PAT_ENCRYPTION_KEY_B64=<generate with: openssl rand -base64 32>
PAT_ENCRYPTION_KEY_ID=v1

# ── P1: Trusted user identity header ─────────────────────────────────────────
# HTTP header name carrying the authenticated app user ID.
# Must be injected ONLY by the trusted upstream layer (Open WebUI, reverse proxy).
# NEVER trust this header if clients can set it directly.
TRUSTED_USER_HEADER=x-forwarded-user
# Optional: header for user display name (metadata only, not used as identity key)
# TRUSTED_USER_NAME_HEADER=x-forwarded-name

# Removed by design — project access is determined by the PAT, not server config:
# ADO_DEFAULT_PROJECT
# ADO_ALLOWED_PROJECTS
# ADO_PROJECT
